{
  "entities": {
    "tickets": {
      "title": "Tickets",
      "description": "User support tickets",
      "type": "object",
      "properties": {
        "id": { "type": "number" },
        "userId": { "type": "number" },
        "text": { "type": "string" },
        "status": { "type": "string", "enum": ["open", "considering", "closed"] },
        "agentId": { "type": "number" },
        "createdAt": { "type": "number" },
        "updatedAt": { "type": "number" },
        "rating": { "type": "number" }
      },
      "required": ["id", "userId", "text", "status", "createdAt"]
    }
  },
  "firestore": {
    "tickets": {
      "schema": "tickets",
      "description": "Collection of user support tickets"
    }
  }
}

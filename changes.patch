+function hasBadWords(input: string): boolean {
+  if (!input) return false;
+
+  const charMap: { [key: string]: string } = {
+    "a": "а", "@": "а", "4": "а",
+    "b": "б", "6": "б",
+    "c": "с", "s": "с", "$": "с", "5": "с",
+    "d": "д", "9": "д",
+    "e": "е", "3": "е",
+    "g": "г",
+    "h": "н",
+    "i": "и", "1": "и", "!": "и", "|": "и",
+    "k": "к",
+    "l": "л",
+    "m": "м",
+    "n": "н",
+    "o": "о", "0": "о",
+    "p": "р",
+    "r": "р",
+    "t": "т", "7": "т",
+    "u": "у", "y": "у",
+    "v": "в", "w": "в", "8": "в",
+    "x": "х",
+    "z": "з",
+    "ё": "е"
+  };
+
+  let lower = input.toLowerCase();
+  let normalized = "";
+  for (let i = 0; i < lower.length; i++) {
+    normalized += charMap[lower[i]] || lower[i];
+  }
+
+  const stripped = normalized.replace(/[^а-яa-z0-9]/gi, "");
+
+  let deDuped = "";
+  for (let i = 0; i < stripped.length; i++) {
+    if (i === 0 || stripped[i] !== stripped[i - 1]) {
+      deDuped += stripped[i];
+    }
+  }
+
+  const badPatterns = [
+    /х[ууееааяяииоо]й/i,
+    /х[ууееааяяииоо]е/i,
+    /х[ууееааяяииоо]я/i,
+    /х[ууееааяяииоо]и/i,
+    /х[ее]р/i,
+    /п[ииее]зд/i,
+    /еб[ааааллббууссззкттввгг]/i,
+    /еб[ооее]/i,
+    /бл[яяааоотуде]/i,
+    /сук[аааииооекк]/i,
+    /суч[ккааееуу]/i,
+    /муд[аааккенеоо]/i,
+    /г[аоо]нд[ооаа]н/i,
+    /п[ииее]д[ооааерр]/i,
+    /п[еее]д[ии]к/i,
+    /з[ааоо]л[уу]п/i,
+    /шл[ююаа]х/i,
+    /ш[аа]л[аа]в/i,
+    /др[оо]ч/i,
+    /м[ааоо]нд[ааоо]/i,
+    /чм[ооошш]/i,
+    /п[ооо]х[уу]/i,
+    /н[аа]х[уу]/i,
+    /в[ыы]еб/i,
+    /з[аа]еб/i,
+    /д[оо]лб[оо]еб/i,
+    /уеб/i,
+    /съеб/i,
+    /п[ооо]рн/i
+  ];
+
+  for (const pat of badPatterns) {
+    if (pat.test(normalized) || pat.test(stripped) || pat.test(deDuped)) {
+      return true;
+    }
+  }
+  return false;

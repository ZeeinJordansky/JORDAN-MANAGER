+function extractReasonAndDuration(remainingArgs: string[]): {
+  reason: string;
+  duration: { days: number; ms: number; text: string; until: number } | null;
+} {
+  if (!remainingArgs || remainingArgs.length === 0) {
+    return { reason: "без причины", duration: null };
+  }
+
+  // 1. Check if first argument(s) is duration: e.g. ["1", "спам"], ["1м", "спам"], ["1", "мин", "спам"], ["1", "день", "спам"]
+  const first = remainingArgs[0].trim().toLowerCase();
+  const mFirst = first.match(/^(\d+)([a-zа-яё]+)?$/i);
+  if (mFirst) {
+    const valStr = mFirst[1];
+    const unitStr = mFirst[2] || "";
+    if (unitStr) {
+      const dur = parseTimeToken(valStr, unitStr);
+      if (dur) {
+        const reason = remainingArgs.slice(1).join(" ").trim() || "без причины";
+        return { reason, duration: dur };
+      }
+    } else {
+      if (remainingArgs.length > 1) {
+        const second = remainingArgs[1].trim().toLowerCase();
+        const durSecond = parseTimeToken(valStr, second);
+        if (durSecond) {
+          const reason = remainingArgs.slice(2).join(" ").trim() || "без причины";
+          return { reason, duration: durSecond };
+        }
+      }
+      const durBare = parseTimeToken(valStr, "");
+      if (durBare) {
+        const reason = remainingArgs.slice(1).join(" ").trim() || "без причины";
+        return { reason, duration: durBare };
+      }
+    }
+  }
+
+  // 2. Check if last argument(s) is duration: e.g. ["спам", "1м"], ["спам", "1", "мин"], ["спам", "1", "день"], ["спам", "1"]
+  if (remainingArgs.length > 1) {
+    if (remainingArgs.length >= 2) {
+      const prev = remainingArgs[remainingArgs.length - 2].trim().toLowerCase();
+      const last = remainingArgs[remainingArgs.length - 1].trim().toLowerCase();
+      const mPrev = prev.match(/^(\d+)$/);
+      if (mPrev) {
+        const dur = parseTimeToken(mPrev[1], last);
+        if (dur) {
+          const reason = remainingArgs.slice(0, -2).join(" ").trim() || "без причины";
+          return { reason, duration: dur };

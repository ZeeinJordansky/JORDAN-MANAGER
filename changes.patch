+    /\*all\b/, /\*все\b/, /\*online\b/, /\*онлайн\b/, /\*everyone\b/,
+    /\[all\|/, /\[все\|/, /\[online\|/, /\[онлайн\|/, /\[everyone\|/
+  ];
+  return patterns.some(p => p.test(lower));
+}

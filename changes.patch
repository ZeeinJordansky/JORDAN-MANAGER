||u.fullName&&u.fullName.toLowerCase().includes(q)||u.nick&&u.nick.toLowerCase().includes(q)).slice(0,50);res.json(results)}catch(e){res.status(500).json({error:e.message})}});app.post(["/api/vk-callback","/callback","/vk-callback"],async(req,res)=>{const{type,object,group_id,secret}=req.body||{};if(type==="confirmation"){return res.status(200).send(CONFIRMATION_CODE)}res.status(200).send("ok");if(type){try{await handleVkEvent(req.body)}catch(e){console.error("Error processing callback:",e)}}});let isLongPollActive=false;let longPollController=null;let lastServerFetchTime=0;async function startBotsLongPoll(){if(!VK_TOKEN||!VK_GROUP_ID){console.log("[LongPoll] VK_TOKEN or VK_GROUP_ID not provided.");return}if(isLongPollActive)return;isLongPollActive=true;activeLongPollSessionId++;const sessionId=activeLongPollSessionId;if(longPollController){try{longPollController.abort()}catch(e){}}longPollController=new AbortController;console.log(`[LongPoll] Starting LongPoll loop (Session ${sessionId})...`);let server="";let key="";let ts="";const getLongPollServer = async () => {try{const res=await axios.get("https://api.vk.com/method/groups.getLongPollServer",{params:{access_token:VK_TOKEN,v:"5.199",group_id:VK_GROUP_ID},timeout:1e4});if(res.data&&res.data.response){server=res.data.response.server;key=res.data.response.key;ts=res.data.response.ts;lastServerFetchTime=Date.now();console.log(`[LongPoll] Connected to LongPoll server: ${server}`);return true}else{console.error("[LongPoll] Failed to get LongPoll server:",res.data);return false}}catch(err){console.error("[LongPoll] Error calling getLongPollServer:",err?.message);return false}};try{while(isLongPollActive&&sessionId===activeLongPollSessionId){if(!server||!key||!ts||Date.now()-lastServerFetchTime>30*60*1e3){const ok=await getLongPollServer();if(!ok){await new Promise(r=>setTimeout(r,3e3));continue}}try{const lpRes=await axios.get(server,{params:{act:"a_check",key,ts,wait:25},timeout:35e3,signal:longPollController?.signal});lastLongPollUpdate=Date.now();const data=lpRes.data;if(!data||data.failed){console.log(`[LongPoll] Server returned failed code: ${data?.failed}`);if(data?.failed===1){ts=data.ts}else{server="";key="";ts=""}continue}if(data.ts)ts=data.ts;if(Array.isArray(data.updates)){for(const update of data.updates){handleVkEvent(update).catch(err=>{console.error("[LongPoll] Error in event handler:",err)})}}}catch(err){if(axios.isCancel(err)||err.name==="AbortError"||sessionId!==activeLongPollSessionId){break}console.error("[LongPoll] Polling error:",err.message);server="";key="";await new Promise(r=>setTimeout(r,2e3))}}}finally{if(sessionId===activeLongPollSessionId){console.log(`[LongPoll] Loop ended for session ${sessionId}, auto-restarting...`);isLongPollActive=false;setTimeout(()=>{startBotsLongPoll()},1e3)}}}function startKeepAliveMethods(){setInterval(async()=>{try{await axios.get("http://localhost:3000/ping",{timeout:2e3})}catch(e){}},1*60*1e3);setInterval(async()=>{try{await firestoreDb.collection("system").doc("heartbeat").set({lastActive:Date.now()})}catch(e){}},5*60*1e3);setInterval(async()=>{try{await axios.get("https://api.vk.com/method/utils.getServerTime",{params:{access_token:VK_TOKEN,v:"5.199"},timeout:3e3})}catch(e){}},10*60*1e3);setInterval(()=>{console.log("[KeepAlive] Текущее время бота:",new Date().toISOString())},3*60*1e3);setInterval(()=>{if(Date.now()-lastLongPollUpdate>45*1e3&&VK_TOKEN){console.log("[KeepAlive] LongPoll не подает признаков жизни (45s), принудительный рестарт...");isLongPollActive=false;startBotsLongPoll()}},15*1e3)}async function startServer(){startKeepAliveMethods();if(process.env.NODE_ENV!=="production"){const vite=await createViteServer({server:{middlewareMode:true},appType:"spa"});app.use(vite.middlewares)}else{const distPath=path.join(process.cwd(), "dist");app.use(express.static(distPath));app.get("*all",(req,res)=>{res.sendFile(path.join(distPath,"index.html"))})}app.listen(PORT,"0.0.0.0",()=>{console.log(`Server running on http://0.0.0.0:${PORT}`);preloadData().then(()=>{startBotsLongPoll()})})}startServer();
